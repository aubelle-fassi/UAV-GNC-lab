%observateur discret
Ld=place(Ad',Ce', exp(Te*[-10, -15, -20, -25, -30, -35]));
Aod=(Ad-Ld'*Ce);
Bod=[Bd Ld'];
Cod=eye(6);
Dod=zeros(6,4);

% Filtre de Kalman Etendu (EKF)
%recupération des mesures des capteurs de position x et z
out = sim('drone_systeme_temps_discret');
y_data = out.y_reel;    
N = length(y_data);  % nombres d'echantillons
% vecteur d'état estimé initial (t=0)
x_est = [0; 0; 0; 0; 0; 0];
x_historique = zeros(6, N); % stockage des 6 états sur les 1001 instants
pk = eye(6) * 10; %certitude initiale sur les etats à t=0
Q=eye(6)*0.0001; %bruit sur le modèle
R=eye(2)*0.0001; %bruit sur le capteur
for k=1:N
    y_mesure=y_data(k,:)'; %recupération des mesure x et z à chanque instant d'échantillonnage
    v1=g;
    v2=0;
    theta_est=x_est(5);
    % matrice jacobienne
    A=[zeros(2) eye(2) zeros(2); zeros(2) zeros(2) [-c*v2*sin(theta_est)-v1*cos(theta_est) 0; c*v2*cos(theta_est)-v1*sin(theta_est) 0]; zeros(2) zeros(2) [0 1;0 0]];
    Aj=eye(6)+Te*A;
    %prédiction d'état
    x_k=x_est(1);
    z_k=x_est(2);
    vx_k = x_est(3);
    vz_k = x_est(4);
    theta_k = x_est(5);
    theta_dot_k=x_est(6);
    f_non_lin=[x_k + Te*vx_k;z_k + Te*vz_k;vx_k + Te*(c*v2*cos(theta_k)-v1*sin(theta_k));vz_k + Te*(c*v2*sin(theta_k)+v1*cos(theta_k)-g);theta_k + Te*theta_dot_k;theta_dot_k + Te*v2];
    %calcul de l'incertitude et du gain de kalman
    pk_pred= Aj*pk*Aj'+Q;
    kk=pk_pred*Ce'*(Ce*pk_pred*Ce'+R)^-1;
    % calcul de l'erreur d'estimation et de l'etat estimé
    e=y_mesure-(Ce*f_non_lin);
    x_est = f_non_lin + kk * e;
    pk = (eye(6) - kk * Ce) * pk_pred;
    x_historique(:, k) = x_est;
end     
