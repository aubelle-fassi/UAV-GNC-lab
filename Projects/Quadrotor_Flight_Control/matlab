%matrices de linéarisation du système
A0=[zeros(2) eye(2) zeros(2); zeros(2) zeros(2) [-c*v20*sin(theta0)-v10*cos(theta0) 0; c*v20*cos(theta0)-v10*sin(theta0) 0]; zeros(2) zeros(2) [0 1;0 0]];
B0=[zeros(2); [-sin(theta0) c*cos(theta0); cos(theta0) c*sin(theta0)]; [0 0;0 1]];
C=[eye(2) zeros(2) zeros(2); zeros(2) zeros(2) eye(2)];
A01=[zeros(2) eye(2) zeros(2); zeros(2) zeros(2) [-c*v20*sin(theta01)-v10*cos(theta01) 0; c*v20*cos(theta01)-v10*sin(theta01) 0]; zeros(2) zeros(2) [0 1;0 0]];
B01=[zeros(2); [-sin(theta01) c*cos(theta01); cos(theta01) c*sin(theta01)]; [0 0;0 1]];
A02=[zeros(2) eye(2) zeros(2); zeros(2) zeros(2) [-c*v20*sin(theta02)-v10*cos(theta02) 0; c*v20*cos(theta02)-v10*sin(theta02) 0]; zeros(2) zeros(2) [0 1;0 0]];
B02=[zeros(2); [-sin(theta02) c*cos(theta02); cos(theta02) c*sin(theta02)]; [0 0;0 1]];
D=zeros(4,2);

%reponse frequentielle
sys0 = ss(A0,B0,C,D);
